KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=           # populated by scripts/kite_auth_server.py or kite_totp_refresh.py

# TOTP auto-refresh (scripts/kite_totp_refresh.py + EC2 cron)
# These allow fully unattended daily token renewal — store carefully.
KITE_USER_ID=                # Zerodha user ID, e.g. AB1234
KITE_PASSWORD=               # Zerodha login password (sensitive — treat like API secret)
KITE_TOTP_SECRET=            # base32 TOTP secret (from Zerodha 2FA setup QR code)

TELEGRAM_BOT_TOKEN=          # Telegram bot token for trade notifications
TELEGRAM_CHAT_ID=            # Telegram chat ID for trade notifications
