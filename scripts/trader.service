[Unit]
Description=Python Trading Bot
# kite-token-refresh.service: boot-time TOTP login (the box boots fresh every
# trading morning at 07:00 IST). Wants= not Requires=: if the login fails the bot
# must still start and crash-loop until a refresh lands (08:15 cron / retries).
After=network-online.target kite-token-refresh.service
Wants=network-online.target kite-token-refresh.service

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/opt/trader
ExecStart=/opt/trader/.venv/bin/python main.py
# Always restart, forever: the token dies at midnight IST, so a restart in the
# token-dead window (e.g. weekend) crash-loops until the next TOTP refresh —
# the service must keep retrying and self-heal rather than hit a start limit.
Restart=always
RestartSec=60
StartLimitIntervalSec=0
# SIGTERM is a hard kill for main.py (only KeyboardInterrupt is handled); all
# state is persisted to SQLite as it happens, so 30 s is plenty.
TimeoutStopSec=30

Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata

MemoryMax=700M
MemorySwapMax=0

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/trader/data /opt/trader/logs /opt/trader/config

StandardOutput=journal
StandardError=journal
SyslogIdentifier=trader

[Install]
WantedBy=multi-user.target
